GOOGLE_API_KEY=your-google-api-key

# LangSmith (Tracing + 평가) — https://smith.langchain.com/
LANGSMITH_API_KEY=your-langsmith-api-key
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=LENA-PJ

# 한국관광공사 공공데이터(data.go.kr B551011) — 아래 5개 서비스 공용 인증키
#  KorService2(국문) / KorPetTourService2(반려동물) / KorWithService2(무장애)
#  Durunubi(두루누비) / TarRlteTarService1(연관관광지)
# data.go.kr 의 "일반 인증키(Decoding)" 값을 넣으세요.
DATA_GO_KR_API_KEY=[APIkey]
# (선택) 요청 식별용 값 — 기본값 ETC / LENA
DATA_GO_KR_MOBILE_OS=ETC
DATA_GO_KR_MOBILE_APP=LENA
